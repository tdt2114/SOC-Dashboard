# SOC Dashboard (Repo B) — environment template
# Copy to .env and adjust. Do NOT commit the real .env.

APP_NAME=soc-dashboard-api
APP_ENV=development
# MOCK_MODE=true serves mock alerts/agents; cases, actions and auth still use Postgres.
MOCK_MODE=true
CORS_ORIGINS=http://localhost:3000
VERIFY_TLS=false
API_TIMEOUT_SECONDS=10
INDEXER_TIMEOUT_SECONDS=10
DEFAULT_TIME_RANGE=24h
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Postgres ---
POSTGRES_DB=soc_dashboard
POSTGRES_USER=soc_dashboard
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=soc-postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://soc_dashboard:change-me@soc-postgres:5432/soc_dashboard

# --- Auth / JWT (change in any non-local environment) ---
JWT_SECRET_KEY=change-this-dev-secret
JWT_REFRESH_SECRET_KEY=change-this-dev-refresh-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Seed users (created on first bootstrap) ---
SEED_DEFAULT_DEPARTMENT_CODE=SOC
SEED_DEFAULT_DEPARTMENT_NAME=Security Operations Center
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@local.test
SEED_ADMIN_PASSWORD=Admin123!ChangeMe
SEED_ADMIN_FULL_NAME=SOC Admin
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_EMAIL=superadmin@local.test
SEED_SUPERADMIN_PASSWORD=SuperAdmin123!ChangeMe
SEED_SUPERADMIN_FULL_NAME=SOC Super Admin

# --- Wazuh integration (Repo A) ---
# If Repo B shares Repo A's compose network, use the service hostnames instead:
#   WAZUH_API_BASE_URL=https://wazuh-manager:55000
#   WAZUH_INDEXER_URL=https://wazuh-indexer:9200
WAZUH_API_BASE_URL=https://host.docker.internal:55000
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=change-me
WAZUH_INDEXER_URL=https://host.docker.internal:9200
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=change-me
WAZUH_ALERT_INDEX_PATTERN=wazuh-alerts-*

# --- Frontend → backend wiring ---
API_BASE_URL=http://soc-backend:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- SOAR approval intake ---
# Shared secret Shuffle SOAR sends as X-SOAR-Token on POST /api/actions.
# Empty disables the SOAR intake endpoint (returns 503).
SOAR_WEBHOOK_TOKEN=change-me-soar-token

# --- AI SOC Analyst ---
# AI_ENABLED=false disables the feature (endpoints return 503).
# With AI_ENABLED=true but no GEMINI_API_KEY, an offline mock provider is used
# (deterministic heuristics) so the feature is testable without an API key.
# AI_MODEL: gemini-2.5-flash (balanced) or gemini-2.5-flash-lite (cheaper/faster).
AI_ENABLED=true
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=20
