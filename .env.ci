APP_ENV=ci
MOCK_MODE=true
CORS_ORIGINS=http://localhost:3000

POSTGRES_DB=soc_dashboard
POSTGRES_USER=soc_dashboard
POSTGRES_PASSWORD=soc_dashboard_ci
POSTGRES_HOST=soc-postgres
POSTGRES_PORT=5432

JWT_SECRET_KEY=ci-access-token-secret-change-outside-ci
JWT_REFRESH_SECRET_KEY=ci-refresh-token-secret-change-outside-ci
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

SEED_DEFAULT_DEPARTMENT_CODE=SOC
SEED_DEFAULT_DEPARTMENT_NAME=Security Operations Center

SEED_ADMIN_USERNAME=ci_admin
SEED_ADMIN_EMAIL=ci.admin@local.test
SEED_ADMIN_PASSWORD=CiAdmin123!ChangeMe
SEED_ADMIN_FULL_NAME=SOC CI Admin

SEED_SUPERADMIN_USERNAME=ci_superadmin
SEED_SUPERADMIN_EMAIL=ci.superadmin@local.test
SEED_SUPERADMIN_PASSWORD=CiSuperAdmin123!ChangeMe
SEED_SUPERADMIN_FULL_NAME=SOC CI Super Admin

SEED_VIEWER_USERNAME=pilot_viewer
SEED_VIEWER_EMAIL=pilot.viewer@local.test
SEED_VIEWER_PASSWORD=PilotViewer123!ChangeMe
SEED_VIEWER_FULL_NAME=SOC Pilot Viewer

SEED_ANALYST_USERNAME=pilot_analyst
SEED_ANALYST_EMAIL=pilot.analyst@local.test
SEED_ANALYST_PASSWORD=PilotAnalyst123!ChangeMe
SEED_ANALYST_FULL_NAME=SOC Pilot Analyst

SEED_ROLE_ADMIN_USERNAME=pilot_admin
SEED_ROLE_ADMIN_EMAIL=pilot.admin@local.test
SEED_ROLE_ADMIN_PASSWORD=PilotAdmin123!ChangeMe
SEED_ROLE_ADMIN_FULL_NAME=SOC Pilot Admin

DEFAULT_TIME_RANGE=24h
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

VERIFY_TLS=false
WAZUH_API_BASE_URL=https://wazuh-manager:55000
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=
WAZUH_INDEXER_URL=https://wazuh-indexer:9200
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=
WAZUH_ALERT_INDEX_PATTERN=wazuh-alerts-*
